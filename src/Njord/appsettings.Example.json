{
  // Deployment-specific settings only. Every default value lives in appsettings.json (the file shipped
  // with njord); a key you do not set here keeps that default. Remove a key to fall back to the default.
  // List defaults (Horizons, Parameters.Groups, alert threshold arrays) are built in: a list you set
  // here replaces the built-in list completely.

  "Serilog": {
    // Log categories (SourceContext) are full type names: njord's actors log as their class
    // (e.g. "Njord.Pipeline.PollWorker"), Akka.NET's internals as Akka.* types. "Akka": "Warning"
    // therefore only quiets Akka itself. The actor system's own log level follows the lowest level
    // configured here (Default and every Override), so a "Debug" override is enough to see an
    // actor's Debug logs; nothing below Information is produced when no Debug level is configured.
    "MinimumLevel": {
      "Override": {
        // ── Debug logs per namespace or actor (disabled by default) ──
        // Uncomment to see Debug logs of one subsystem or one actor. A key matches its
        // category and everything below it ("Njord.Pipeline" covers PollManager, PollWorker and
        // ForecastPipeline).
        //
        // "Njord.Pipeline": "Debug",                 // poll scheduling, analysis pipeline
        //
        // ── Stream tracing ──
        // Element-level tracing of a stream graph: its .Log() stages log through the
        // owning actor, so enable Debug for that actor's category.
        //
        // "Njord.Mqtt.MqttStatePublisher": "Debug"   // .Log() stages mqtt-state-in (PipelineEvents
        //                                            // entering) and mqtt-state-out (MqttMessages
        //                                            // after mapping, before publish)
      }
    }
  },

  "Njord": {

    // ── Models ─────────────────────────────────────────────────────────
    // Global model list applied to ALL locations. Free-form Open-Meteo
    // model ids. Unknown ids are allowed (forward-compatible) but will
    // produce HTTP 400 if the API doesn't recognize them.
    //
    // Verified working ids (2026-07-11):
    //   icon_d2              - DWD ICON-D2 (Germany, ~2 km, ~48–64 h)
    //   icon_eu              - DWD ICON-EU (Europe, ~7 km, ~120 h)
    //   icon_global          - DWD ICON Global (~13 km, ~180 h)
    //   ecmwf_ifs025         - ECMWF IFS 0.25° (global, ~240 h)
    //   gfs_seamless         - NOAA GFS Seamless (global, ~384 h)
    //   ukmo_seamless        - UK Met Office Seamless (global, ~168 h)
    //   arpege_europe        - Météo-France ARPEGE (Europe, ~96 h)
    //   knmi_harmonie_arome_europe      - KNMI HARMONIE-AROME Europe (~48 h)
    //   knmi_harmonie_arome_netherlands - KNMI HARMONIE-AROME NL (~48 h)
    //   dmi_harmonie_arome_europe       - DMI HARMONIE-AROME Europe (~60 h)
    //   meteoswiss_icon_ch1  - MeteoSwiss ICON-CH1 (~1 km, Alps, ~33 h)
    //   meteoswiss_icon_ch2  - MeteoSwiss ICON-CH2 (~2 km, Alps, ~45 h)
    "Models": [
      "icon_global",
      "icon_eu",
      "ecmwf_ifs025",
      "gfs_seamless",
      "ukmo_seamless",
      "arpege_europe",
      "knmi_harmonie_arome_europe",
      "dmi_harmonie_arome_europe"
    ],

    // ── Locations ──────────────────────────────────────────────────────
    // At least one location is required. Each location produces its own
    // set of HA devices (one per model).
    //
    // "Models" per location is OPTIONAL: when set, these model ids are
    // MERGED with the global Models list (union, no duplicates).
    // Use this for regional high-resolution models that only cover
    // certain areas (e.g. icon_d2 for Germany, knmi for Netherlands).
    //
    // Validation checks model coverage: a known model outside its documented
    // geographic area fails startup validation.
    "Locations": [
      {
        "Name": "luzern",
        "Latitude": 47.0502,
        "Longitude": 8.3093,
        "Models": [ "icon_d2", "meteoswiss_icon_ch1", "meteoswiss_icon_ch2" ]
      }
    ],

    // ── Optional overrides (defaults are in appsettings.json) ──────────
    // "PollInterval": "00:30:00",       // format HH:MM:SS, must be > 00:00:00
    // "ForecastDays": 7,                // 1–16, more than 14 days counts as 2x API weight
    // "Horizons": [ 6, 24 ],            // hours ahead, each 1–96; replaces the built-in list
    // "Parameters": { "Groups": [ "Weather", "Solar" ], "Exclude": [ "snowfall" ] },
    //
    // Open-Meteo free tier: 300,000 requests/month, 600/minute. Startup validates that
    // projected usage stays below 80% of the budget. Set BudgetOverride to self-throttle below
    // the free-tier limits (e.g. if sharing the quota with other applications).
    // "BudgetOverride": { "RequestsPerMonth": 100000, "RequestsPerMinute": 200 },

    // ── MQTT ───────────────────────────────────────────────────────────
    // MQTT is disabled by default (gRPC-only mode). Enable it to connect to a Mosquitto broker
    // and publish retained state topics (no MQTT Discovery payloads; Home Assistant connects
    // over gRPC through the ha-njord integration).
    "Mqtt": {
      "Enabled": true,

      // REQUIRED when Enabled is true. The Mosquitto broker host
      // (usually the HA host IP). Startup fails fast when empty.
      "Host": "192.168.1.100"

      // Optional credentials. The password should come from an
      // environment variable (Njord__Mqtt__Password) rather than
      // being stored in this file.
      // "Username": "njord",
      // "Password": "..."
    },

    // ── Enrichment ─────────────────────────────────────────────────────
    // Each enrichment feature can be independently enabled/disabled. Disabled features
    // produce no HA entities and no MQTT traffic. Examples of overrides:
    //
    // "Enrichment": {
    //   "Consensus": { "Method": "TrimmedMean", "TrimPercent": 0.1 },
    //   "Trends": { "Enabled": true },
    //   "Indices": {
    //     "Enabled": true,
    //     "Preferences": { "IndoorTemp": 22.0, "IdealOutdoorTemp": 22.0, "HeatSensitivity": 1.0 }
    //   }
    // },

    // ── Persistence ────────────────────────────────────────────────────
    // Backend for Akka.Persistence (poll workers' learned cycles). The default is a SQLite file
    // at PersistencePath (mount /app/data as a volume in Docker). For PostgreSQL:
    //
    // "Persistence": {
    //   "Provider": "PostgreSql",
    //   "ConnectionString": "Host=localhost;Database=njord;Username=njord;Password=..."
    // }
  }
}
