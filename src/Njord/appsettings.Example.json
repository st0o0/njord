{
  // Deployment-specific settings only. Every default value lives in appsettings.json (the file shipped
  // with njord); a key you do not set here keeps that default. Remove a key to fall back to the default.
  // List defaults (feature threshold arrays) are built in: a list you set
  // here replaces the built-in list completely.

  "Serilog": {
    // Log categories (SourceContext) are full type names: njord's actors log as their class
    // (e.g. "Njord.Polling.PollWorker"), Akka.NET's internals as Akka.* types. "Akka": "Warning"
    // therefore only quiets Akka itself. The actor system's own log level follows the lowest level
    // configured here (Default and every Override), so a "Debug" override is enough to see an
    // actor's Debug logs; nothing below Information is produced when no Debug level is configured.
    "MinimumLevel": {
      "Override": {
        // ── Debug logs per namespace or actor (disabled by default) ──
        // Uncomment to see Debug logs of one subsystem or one actor. A key matches its
        // category and everything below it ("Njord.Pipeline" covers PollManager, PollWorker and
        // ForecastPipeline).
        //
        // "Njord.Pipeline": "Debug",                 // poll scheduling, analysis pipeline
      }
    }
  },

  "Njord": {

    // ── Locations ──────────────────────────────────────────────────────
    // At least one location is required, each with Name, Latitude and Longitude.
    "Locations": [
      {
        "Name": "luzern",
        "Latitude": 47.0502,
        "Longitude": 8.3093
      }
    ],

    // ── Optional overrides (defaults are in appsettings.json) ──────────
    // "Polling": { "PollInterval": "00:30:00" },  // format HH:MM:SS, must be > 00:00:00
    // "Weather": { "ForecastDays": 7, "Models": [ "ecmwf_ifs025_ensemble_mean", "ecmwf_aifs025_ensemble_mean" ] },  // Models: first is primary; more than one only takes effect with Features:ModelComparison, which multiplies the API weight by the model count
    // "Weather": { "ForecastDays": 7 },  // ForecastDays 1–16, more than 14 days counts as 2x API weight
    // "AirQuality": { "ForecastDays": 5, "Region": "Global" },  // Region: Global, Europe (adds ammonia, olive pollen), UnitedStates (adds US AQI)
    // "Marine": { "ForecastDays": 8 },      // 1–8
    // "Flood": { "ForecastDays": 92, "IncludeEnsemble": false },      // 1–210; ensemble = 50 members, 5x call weight
    //
    // Open-Meteo free tier: 300,000 requests/month, 600/minute. Startup validates that
    // projected usage stays below 80% of the budget. Set BudgetOverride to self-throttle below
    // the free-tier limits (e.g. if sharing the quota with other applications).
    // "Polling": { "BudgetOverride": { "RequestsPerMonth": 100000, "RequestsPerMinute": 200 } },

    // ── Features ───────────────────────────────────────────────────────
    // Each feature (Frost, Heat, Pollen, Laundry, FloodRisk, ...) can be
    // independently enabled/disabled. Disabled features produce no HA entities; the fetched
    // domains follow from the enabled features. Only list the ones that differ from the default.
    // "Features": { "Frost": { "Enabled": false }, "FloodRisk": { "Enabled": true }, "Laundry": { "Enabled": true } },

    // ── Feature settings ───────────────────────────────────────────────
    // A feature section also holds its own options (thresholds etc.); a list you set replaces the
    // built-in list completely. Option names and defaults are listed in docs/data/features.json.
    //
    // "Features": {
    //   "Frost": { "Enabled": true, "Thresholds": [0, -5, -15] },
    //   "HeavyRain": { "HourlyThreshold": 10, "DailyThreshold": 25 }
    // },

    // ── Persistence ────────────────────────────────────────────────────
    // Backend for Akka.Persistence (poll workers' learned cycles). The default is a SQLite file
    // at Persistence:DataPath (mount /app/data as a volume in Docker). For PostgreSQL:
    //
    // "Persistence": {
    //   "Provider": "PostgreSql",
    //   "ConnectionString": "Host=localhost;Database=njord;Username=njord;Password=..."
    // }
  }
}
