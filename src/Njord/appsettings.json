{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Akka": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Grpc.AspNetCore.Server": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning"
      }
    }
  },
  "Njord": {
    "PollInterval": "01:00:00",
    "DiscoveryInterval": "00:20:00",
    "ForecastDays": 4,
    "OpenMeteoBaseUrl": "https://api.open-meteo.com/",
    "PersistencePath": "data/njord.db",
    "Persistence": {
      "Provider": "Sqlite"
    },
    "Mqtt": {
      "Enabled": false,
      "Port": 1883,
      "DiscoveryPrefix": "homeassistant",
      "BaseTopic": "njord"
    },
    "Sensors": {
      "Enabled": true,
      "StalenessSeconds": 7200
    },
    "Enrichment": {
      "Consensus": {
        "Enabled": true,
        "Method": "Median",
        "TrimPercent": 0.1,
        "MinQuorum": 2
      },
      "Alerts": {
        "Enabled": true,
        "HeavyRainHourlyThreshold": 10.0,
        "HeavyRainDailyThreshold": 25.0,
        "PressureDropThreshold": 5.0,
        "PressureDropSevereThreshold": 10.0,
        "FogPersistentHours": 4,
        "CapeThreshold": 1000.0,
        "ThunderstormPrecipThreshold": 5.0,
        "ThunderstormGustThreshold": 15.0,
        "IceThreshold": 2.0
      },
      "Derived": {
        "Enabled": true
      },
      "Trends": {
        "Enabled": false
      },
      "Indices": {
        "Enabled": false
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
