{
  "stryker-config": {
    "test-runner": "mtp",
    "reporters": ["progress", "cleartext", "html", "json", "markdown"],
    "thresholds": {
      "high": 80,
      "low": 65,
      "break": 65
    },
    "ignore-mutations": ["string"],
    "mutate": [
      "!**/obj/**",
      "!**/*Options.cs",
      "!**/*OptionsValidator.cs",
      "!**/*Config.cs",
      "!**/*ConfigValidator.cs",
      "!**/ServiceCollectionExtensions.cs",
      "!**/*Setup.cs",
      "!**/BudgetTracker.cs",
      "!**/Results/FeatureRule.cs",
      "!**/Results/IFeatureRule.cs"
    ]
  }
}
