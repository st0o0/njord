{
  "stryker-config": {
    "test-runner": "mtp",
    "reporters": ["progress", "cleartext", "html", "json", "markdown"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "ignore-mutations": ["string"],
    "mutate": ["!**/obj/**", "!**/*Options.cs", "!**/*OptionsValidator.cs", "!**/ServiceCollectionExtensions.cs", "!**/*SetupContainer.cs"]
  }
}
