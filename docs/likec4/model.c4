model {
  openMeteo = externalSystem 'Open-Meteo API' {
    description 'Free weather forecast API, ICON, ECMWF, GFS, UKMO, and 50+ models'
  }

  njord = system 'njord' {
    description '.NET service on Akka.NET + Akka.Streams'

    ingest = container 'Ingest' {
      #ingest
      description 'Open-Meteo gateway and HTTP client'

      openMeteoGateway = component 'OpenMeteoGateway' {
        #ingest
        description 'Fetch stream, budget throttle, two parallel fetches, forecast broadcast hub'
      }
      openMeteoClient = component 'OpenMeteoClient' {
        #ingest
        description 'HTTP client, builds requests, parses JSON into Forecast records'
      }
    }

    domain = container 'Domain' {
      #domain
      description 'Poll scheduling, forecast pipeline, analysis libraries'

      pollManager = component 'PollManager' {
        #domain
        description 'Cluster singleton: starts one poll worker per configured target, answers poll-state queries'
      }
      pollWorker = component 'PollWorker' {
        #domain
        description 'Persistent shard entity per location/model target: decides when it is fetched'
      }
      forecastPipeline = component 'ForecastPipeline' {
        #domain
        description 'Analysis stream, consensus per forecast, then all enabled features'
      }
      analysis = component 'Analysis libraries' {
        #domain
        description 'Consensus, alerts, derived values, trends, indices'
      }
      budgetTracker = component 'BudgetTracker' {
        #domain
        description 'Persistent request budget usage per minute, day and month'
      }
      sensorHub = component 'SensorHub' {
        #domain
        description 'Latest indoor sensor readings pushed over gRPC'
      }
    }

    consumers = container 'Consumers' {
      #egress
      description 'Output adapters attached to the pipeline via SourceRef'

      readModel = component 'ForecastReadModel' {
        #egress
        description 'Latest forecasts and analysis results per location'
      }
      grpcApi = component 'gRPC API' {
        #egress
        description 'Weather, Admin, Ops and Sensor services on port 8081'
      }
      mqttStatePublisher = component 'MqttStatePublisher' {
        #egress
        description 'Optional, retained state JSON per model, horizon and feature'
      }
    }

    pipeline = container 'Pipeline' {
      #pipeline
      description 'Akka.Streams data flow, fetch to consumers'

      fetchQueue = component 'Fetch queue' {
        #pipeline
        description 'FetchForecast requests from the poll workers'
      }
      throttle = component 'GatewayThrottleStage' {
        #pipeline
        description 'Token bucket that keeps requests within the API budget'
      }
      httpStage = component 'Fetch' {
        #pipeline
        description 'SelectAsyncUnordered(2) calls to OpenMeteoClient'
      }
      forecastHub = component 'Forecast hub' {
        #pipeline
        description 'BroadcastHub of successful forecasts, handed out as SourceRef'
      }
      analyze = component 'Analyze' {
        #pipeline
        description 'ZipWith sensor snapshot, StatefulSelectMany over all analysis features'
      }
      eventHub = component 'PipelineEvent hub' {
        #pipeline
        description 'BroadcastHub of typed PipelineEvents for consumers'
      }
    }

    persistence = dataStore 'SQLite' {
      description 'Journal and snapshots for budget usage and the poll workers' state'
    }
  }

  mqttBroker = dataStore 'MQTT Broker' {
    description 'Optional, retained state and availability topics'
  }

  homeAssistant = externalSystem 'Home Assistant' {
    description 'ha-njord custom integration, connected over gRPC'
  }

  // System-level relationships
  openMeteo -> njord 'forecast data'
  njord -> homeAssistant 'gRPC streams (ha-njord)'
  njord -> mqttBroker 'optional state JSON'

  // Internal relationships
  pollManager -> pollWorker 'StartPolling / TriggerTargetPoll'
  pollWorker -> pollManager 'PollWorkerReport'
  pollWorker -> openMeteoGateway 'FetchForecast'
  openMeteoGateway -> openMeteoClient 'fetch'
  openMeteoClient -> openMeteo 'HTTP GET /v1/forecast'
  openMeteoGateway -> forecastPipeline 'SourceRef<Forecast>'
  sensorHub -> forecastPipeline 'sensor snapshot'
  forecastPipeline -> analysis 'ConsensusSnapshot'
  forecastPipeline -> readModel 'SourceRef<PipelineEvent>'
  forecastPipeline -> mqttStatePublisher 'SourceRef<PipelineEvent>'
  grpcApi -> readModel 'queries + streams'
  grpcApi -> sensorHub 'sensor readings'
  grpcApi -> homeAssistant 'gRPC streams'
  mqttStatePublisher -> mqttBroker 'state JSON'
  pollWorker -> persistence 'poll state per target'
  openMeteoGateway -> budgetTracker 'recorded calls'
  budgetTracker -> persistence 'budget usage'

  // Pipeline flow
  fetchQueue -> throttle 'targets'
  throttle -> httpStage 'throttled targets'
  httpStage -> openMeteo 'HTTP GET'
  httpStage -> forecastHub 'Forecast'
  forecastHub -> analyze 'SourceRef<Forecast>'
  analyze -> eventHub 'PipelineEvent'
  eventHub -> homeAssistant 'gRPC via ForecastReadModel'
  eventHub -> mqttBroker 'via MqttStatePublisher'
}
