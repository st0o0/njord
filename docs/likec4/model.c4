model {

  // ---- external systems ----

  openMeteo = external 'Open-Meteo API' {
    description 'Free weather API: Forecast, Ensemble Mean, Air Quality, Flood, Marine, Seasonal endpoints'
    link https://open-meteo.com/en/docs
  }

  homeAssistant = external 'Home Assistant' {
    description 'ha-njord custom integration, connected over gRPC streaming'
    link https://github.com/st0o0/ha-njord
  }

  // ---- njord ----

  njord = system 'njord' {
    description '.NET service on Akka.NET + Akka.Streams: polls Open-Meteo, evaluates 89 feature rules, streams results over gRPC'

    // ==== Njord.OpenMeteo ====

    openMeteoProject = container 'Njord.OpenMeteo' {
      description 'Gateway and 6 typed HTTP clients, one per Open-Meteo domain'

      gateway = singleton 'OpenMeteoGateway' {
        description 'Stream-based dispatch: queue, budget gate, SelectAsyncUnordered, WireTap reply, SinkRef to pipeline'
      }

      budgetGate = child 'GatewayBudgetGate' {
        description 'Token-bucket rate limiter (80% of requests/min, burst max(rate/30, 16))'
      }

      forecastClient = child 'ForecastClient' {
        description 'api.open-meteo.com/v1/forecast: deterministic best_match (1-9 km)'
      }

      ensembleClient = child 'EnsembleClient' {
        description 'ensemble-api.open-meteo.com/v1/ensemble: spread variables + ensemble-mean models'
      }

      airQualityClient = child 'AirQualityClient' {
        description 'air-quality-api.open-meteo.com: PM2.5, PM10, ozone, pollen, European/US AQI'
      }

      floodClient = child 'FloodClient' {
        description 'flood-api.open-meteo.com: GloFAS river discharge (mean, median, P25, P75, max)'
      }

      marineClient = child 'MarineClient' {
        description 'marine-api.open-meteo.com: waves, swell, currents, SST'
      }

      seasonalClient = child 'SeasonalClient' {
        description 'seasonal-api.open-meteo.com: monthly anomalies, weekly EFI/SOT probabilities'
      }
    }

    // ==== Njord.Polling ====

    pollingProject = container 'Njord.Polling' {
      description 'Poll scheduling: one PollManager singleton + one PollWorker shard entity per location'

      pollManager = singleton 'PollManager' {
        description 'One target per location; StartPolling/StopPolling, poll state + health from reports'
      }

      pollWorker = shard 'PollWorker' {
        #persistent
        description 'Entity per location: per-domain independent timers, discovery -> learned cycle, FetchDomain dispatch'
      }
    }

    // ==== Njord.Pipeline ====

    pipelineProject = container 'Njord.Pipeline' {
      #pipeline
      description 'MergeHub -> FeatureEngine -> BroadcastHub streaming pipeline'

      forecastPipeline = singleton 'ForecastPipeline' {
        #pipeline
        description 'MergeHub (domain data in) -> FeatureEngine -> BroadcastHub (pipeline events out)'
      }

      featureEngine = child 'FeatureEngine' {
        #pipeline
        description 'Ring buffer of LocationForecasts per location, domain slot replacement, rule dispatch by requirements'
      }
    }

    // ==== Njord.Features ====

    featuresProject = container 'Njord.Features' {
      description '89 IFeatureRule implementations across 7 OutputKinds'

      featureRules = child 'Feature rules' {
        description 'Alert (30), Score (7), Condition (23), Trend (1), Forecast (4), Weather (1), Observation (23)'
      }
    }

    // ==== Njord.Budget ====

    budgetProject = container 'Njord.Budget' {
      description 'Persistent API usage accounting and health check'

      budgetTracker = singleton 'BudgetTracker' {
        #persistent
        description 'Per-minute, per-day, per-month usage tracking; health check source'
      }
    }

    // ==== Njord.Grpc ====

    grpcProject = container 'Njord.Grpc' {
      description 'gRPC service and entity state management'

      grpcConsumer = singleton 'GrpcConsumer' {
        description 'Entity state (EntityStates/StaleEntities), BroadcastHub of EntityEvents, availability tracking'
      }

      grpcService = child 'NjordGrpcService' {
        description 'gRPC service on port 8081: GetManifest, Subscribe, GetStatus, TriggerPoll'
      }

      manifestBuilder = child 'ManifestBuilder' {
        description 'Entity definitions from FeatureDescriptor.EntityMetadata x locations at startup'
      }
    }

    // ==== Persistence ====

    persistence = store 'SQLite / PostgreSQL' {
      description 'Akka.Persistence journal and snapshots for PollWorker state and BudgetTracker usage'
    }
  }

  // ---- context relationships ----

  openMeteo -> njord 'weather data (6 domains)'
  njord -> homeAssistant 'gRPC streaming (ha-njord)'

  // ---- Njord.OpenMeteo: gateway to clients ----

  gateway -> budgetGate 'rate-limited requests'
  gateway -> forecastClient 'Forecast'
  gateway -> ensembleClient 'Ensemble'
  gateway -> airQualityClient 'AirQuality'
  gateway -> floodClient 'Flood'
  gateway -> marineClient 'Marine'
  gateway -> seasonalClient 'Seasonal'
  forecastClient -[http]-> openMeteo 'HTTP GET'
  ensembleClient -[http]-> openMeteo 'HTTP GET'
  airQualityClient -[http]-> openMeteo 'HTTP GET'
  floodClient -[http]-> openMeteo 'HTTP GET'
  marineClient -[http]-> openMeteo 'HTTP GET'
  seasonalClient -[http]-> openMeteo 'HTTP GET'

  // ---- Njord.Polling: scheduling ----

  pollManager -[tell]-> pollWorker 'StartPolling / StopPolling'
  pollWorker -[tell]-> pollManager 'PollWorkerReport'
  pollWorker -[tell]-> gateway 'FetchDomain'
  gateway -[tell]-> pollWorker 'FetchDomainCompleted / Failed / Rejected'

  // ---- Njord.Pipeline: data flow ----

  gateway -[stream]-> forecastPipeline 'SinkRef: DomainDataReceived'
  forecastPipeline -> featureEngine 'process domain data'
  featureEngine -> njord.featuresProject.featureRules 'evaluate matching rules'
  forecastPipeline -[stream]-> grpcConsumer 'SourceRef: PipelineEvent'

  // ---- Njord.Grpc: consumers ----

  grpcConsumer -> grpcService 'entity state updates'
  grpcService -> manifestBuilder 'entity definitions'
  grpcService -> homeAssistant 'gRPC streams'

  // ---- persistence ----

  pollWorker -[journal]-> njord.persistence 'DomainPolled events'
  budgetTracker -[journal]-> njord.persistence 'budget usage events'

  // ---- budget ----

  gateway -[tell]-> budgetTracker 'RecordApiCall'
}
