model {
  openMeteo = externalSystem 'Open-Meteo API' {
    description 'Free weather API: Ensemble Mean (weather, solar), Air Quality and Flood endpoints'
  }

  njord = system 'njord' {
    description '.NET service on Akka.NET + Akka.Streams'

    ingest = container 'Ingest' {
      #ingest
      description 'Open-Meteo gateway and HTTP client'

      openMeteoGateway = component 'OpenMeteoGateway' {
        #ingest
        description 'Routes FetchDomain requests to Weather, Air Quality and Flood, budget throttle, parallel fetches'
      }
      openMeteoClient = component 'OpenMeteoClient' {
        #ingest
        description 'HTTP client, builds requests, parses JSON into DomainForecast records'
      }
    }

    domain = container 'Domain' {
      #domain
      description 'Poll scheduling, projection engine, alert libraries'

      pollManager = component 'PollManager' {
        #domain
        description 'Cluster singleton: starts one poll worker per configured location, answers poll-state queries'
      }
      pollWorker = component 'PollWorker' {
        #domain
        description 'Persistent shard entity per location: decides when it is fetched, fetches all three domains'
      }
      forecastPipeline = component 'ForecastPipeline' {
        #domain
        description 'ProjectionEngine keeps a LocationForecast per location and runs the affected projection groups'
      }
      analysis = component 'Alert libraries' {
        #domain
        description 'Weather, air quality and flood alerts, including cross-domain FloodRain'
      }
      budgetTracker = component 'BudgetTracker' {
        #domain
        description 'Persistent request budget usage per minute, day and month'
      }
    }

    consumers = container 'Consumers' {
      #egress
      description 'Output adapters attached to the pipeline via SourceRef'

      grpcApi = component 'gRPC API' {
        #egress
        description 'GrpcConsumer plus Weather and Ops services on port 8081'
      }
      mqttStatePublisher = component 'MqttStatePublisher' {
        #egress
        description 'Optional, retained state JSON per domain, parameter and alert'
      }
    }

    pipeline = container 'Pipeline' {
      #pipeline
      description 'Akka.Streams data flow, fetch to consumers'

      fetchQueue = component 'Fetch queue' {
        #pipeline
        description 'FetchDomain requests from the poll workers'
      }
      throttle = component 'GatewayThrottleStage' {
        #pipeline
        description 'Token bucket that keeps requests within the API budget'
      }
      httpStage = component 'Fetch' {
        #pipeline
        description 'SelectAsyncUnordered calls to OpenMeteoClient'
      }
      domainHub = component 'MergeHub' {
        #pipeline
        description 'MergeHub of DomainDataReceived from the fetch branch'
      }
      projection = component 'ProjectionEngine' {
        #pipeline
        description 'Updates the LocationForecast and evaluates projection groups by domain'
      }
      eventHub = component 'PipelineEvent hub' {
        #pipeline
        description 'BroadcastHub of typed PipelineEvents for consumers'
      }
    }

    persistence = dataStore 'SQLite' {
      description 'Journal and snapshots for budget usage and the poll workers state'
    }
  }

  mqttBroker = dataStore 'MQTT Broker' {
    description 'Optional, retained state and availability topics'
  }

  homeAssistant = externalSystem 'Home Assistant' {
    description 'ha-njord custom integration, connected over gRPC'
  }

  // System-level relationships
  openMeteo -> njord 'weather, air quality, flood data'
  njord -> homeAssistant 'gRPC streams (ha-njord)'
  njord -> mqttBroker 'optional state JSON'

  // Internal relationships
  pollManager -> pollWorker 'StartPolling / TriggerImmediatePoll'
  pollWorker -> pollManager 'PollWorkerReport'
  pollWorker -> openMeteoGateway 'FetchDomain'
  openMeteoGateway -> openMeteoClient 'fetch'
  openMeteoClient -> openMeteo 'HTTP GET'
  openMeteoGateway -> forecastPipeline 'SinkRef<DomainDataReceived>'
  forecastPipeline -> analysis 'projection groups'
  forecastPipeline -> grpcApi 'SourceRef<PipelineEvent>'
  forecastPipeline -> mqttStatePublisher 'SourceRef<PipelineEvent>'
  grpcApi -> homeAssistant 'gRPC streams'
  mqttStatePublisher -> mqttBroker 'state JSON'
  pollWorker -> persistence 'poll state per location'
  openMeteoGateway -> budgetTracker 'recorded calls'
  budgetTracker -> persistence 'budget usage'

  // Pipeline flow
  fetchQueue -> throttle 'domain requests'
  throttle -> httpStage 'throttled requests'
  httpStage -> openMeteo 'HTTP GET'
  httpStage -> domainHub 'DomainDataReceived'
  domainHub -> projection 'DomainDataReceived'
  projection -> eventHub 'PipelineEvent'
  eventHub -> homeAssistant 'gRPC via GrpcConsumer'
  eventHub -> mqttBroker 'via MqttStatePublisher'
}
