specification {

  // ---- context level ----

  element person {
    notation "Person"
    style {
      shape person
      color green
    }
  }

  element external {
    notation "External system"
    style {
      color gray
    }
  }

  element system {
    notation "Software system"
    style {
      color primary
    }
  }

  // ---- container level ----

  element container {
    notation "Container (zone)"
    style {
      color blue
    }
  }

  element domain {
    notation "Domain project"
    style {
      color indigo
    }
  }

  element store {
    notation "Data store"
    style {
      shape storage
      color slate
    }
  }

  // ---- actors, by hosting role ----

  element singleton {
    notation "Cluster singleton"
    technology "Akka cluster singleton"
    style {
      color primary
      shape component
    }
  }

  element shard {
    notation "Shard region entity"
    technology "Akka sharded entity"
    style {
      color secondary
      shape component
      multiple true
    }
  }

  element child {
    notation "Child / component"
    style {
      color slate
      shape component
      size sm
    }
  }

  // ---- tags ----

  tag persistent
  tag pipeline

  // ---- relationship kinds ----

  relationship http {
    technology "HTTP"
  }

  relationship ask {
    technology "Akka Ask"
  }

  relationship tell {
    technology "Akka Tell"
    line dashed
  }

  relationship journal {
    technology "Akka.Persistence"
    line dotted
  }

  relationship stream {
    technology "Akka.Streams"
    color green
  }
}
